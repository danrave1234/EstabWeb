NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# PayMongo (Philippines payments - Stripe is not available in PH)
# PAYMONGO_SECRET_KEY=sk_test_... or sk_live_... (for API: create links, webhooks)
# PAYMONGO_PUBLIC_KEY=pk_test_... or pk_live_... (optional, for client-side)
# PAYMONGO_WEBHOOK_SECRET=whsec_... (for verifying webhook signatures)

# Database - Transaction Pooler (Port 6543)
DATABASE_URL=postgresql://your-user:your-password@your-host:6543/postgres

# Supabase Auth/DB Details
DB_HOST=your-host
DB_PORT=6543
DB_NAME=postgres
DB_USER=your-user
DB_PASSWORD=your-password

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
# Model used by /api/ai/populate-template (must support generateContent)
GEMINI_TEMPLATE_MODEL=gemini-2.5-flash
# Enable Google Search grounding for latest public business info
GEMINI_TEMPLATE_USE_SEARCH=true

# GEO crawler policy: max-visibility (default) | training-restricted
GEO_CRAWLER_POLICY_MODE=max-visibility

# Lead form notifications — optional; leads are always stored in the dashboard
#
# Option A — SMTP (Zoho Mail, Google Workspace, etc.). When SMTP_HOST is set, this takes priority over Resend.
# Zoho (example): smtp.zoho.com:465, or smtp.zoho.eu for EU. Use an app-specific password if 2FA is on.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=notifications@estabweb.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="EstabWeb <notifications@estabweb.com>"
#
# Option B — Resend (API)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="EstabWeb <no-reply@estabweb.com>"
